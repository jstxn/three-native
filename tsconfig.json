{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "extends": "expo/tsconfig.base",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "packages/three-native/runtime/**/*.tsx",
    "packages/three-native/runtime/**/*.ts",
    "packages/three-native/**/*.d.ts",
    "packages/three-native/**/*.d.mts"
  ]
}
