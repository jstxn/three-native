{
  "name": "@jstxn/three-native",
  "version": "0.4.0",
  "description": "Run existing Three.js scenes on iOS and the web with a generated native host.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "three-native": "bin/three-native.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/config.mjs"
    },
    "./runtime": {
      "types": "./runtime/ThreeView.tsx",
      "default": "./runtime/ThreeView.tsx"
    },
    "./native": {
      "types": "./runtime/native.d.mts",
      "react-native": "./runtime/native.ts",
      "default": "./runtime/native.web.mjs"
    }
  },
  "files": [
    "bin",
    "lib",
    "runtime",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check bin/three-native.mjs && node --check lib/project.mjs && node --check lib/analyze.mjs && node --check lib/watch.mjs && node --check runtime/BrowserEntry.mjs && node --check lib/tooling.mjs && node --check runtime/native-core.mjs && node --check runtime/devices.mjs && node --check lib/automation.mjs && node --check lib/automation-mcp.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/core": "7.29.13",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jstxn/three-native.git",
    "directory": "packages/three-native"
  },
  "homepage": "https://github.com/jstxn/three-native#readme",
  "bugs": {
    "url": "https://github.com/jstxn/three-native/issues"
  }
}
